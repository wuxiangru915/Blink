        <!-- Frontend nodes -->
        <mxCell id="f-start" value="用户输入&#xa;topic_direction&#xa;『AI Agent』" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" vertex="1" parent="sw-frontend">
