        <!-- Swimlane: Backend FastAPI -->
        <mxCell id="sw-backend" value="② 后端层  ·  FastAPI  ·  app/api/v1/workflow.py  ·  app/dependencies/auth.py" style="swimlane;startSize=30;horizontal=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="264" width="1760" height="220" as="geometry" />
        </mxCell>
        <mxCell id="b-auth" value="JWT 鉴权&#xa;get_current_user()&#xa;verify_thread_owner()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="sw-backend">
