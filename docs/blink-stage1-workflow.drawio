        <mxCell id="f-btn-start" value="POST&#xa;/workflow/start&#xa;{ topic_direction }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="sw-frontend">
          <mxGeometry x="210" y="70" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f-card-topic" value="选题卡片&#xa;interrupt #1&#xa;action_required=select_topic&#xa;options: 5个标题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;strokeWidth=1.5;" vertex="1" parent="sw-frontend">
          <mxGeometry x="430" y="45" width="170" height="90" as="geometry" />
