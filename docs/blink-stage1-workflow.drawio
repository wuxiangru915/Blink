        <mxCell id="b-note" value="所有写操作后： updated_state = aget_state(config)  →  next_nodes / is_completed / interrupt_info / node_metrics" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#d79b00;fontStyle=2;" vertex="1" parent="sw-backend">
