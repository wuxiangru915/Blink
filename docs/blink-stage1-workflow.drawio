        <mxCell id="f-resume-topic" value="POST /resume&#xa;{ select_topic,&#xa;  selected_topic }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="sw-frontend">
