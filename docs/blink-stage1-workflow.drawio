        </mxCell>
        <mxCell id="f-sse" value="SSE 流式渲染&#xa;llm_token 逐字&#xa;POST /stream/resume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="sw-frontend">
