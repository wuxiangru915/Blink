        <!-- Title -->
        <mxCell id="title" value="Blink 阶段1：LangGraph 双中断工作流全链路（前端 / 后端 / 引擎 / 持久化）" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="thread_id = {user.id}_{uuid} &amp;nbsp;|&amp;nbsp;  config = { configurable: { thread_id } }  &amp;nbsp;|&amp;nbsp;  Checkpoint 统一由 AsyncPostgresSaver 持久化" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="38" width="1760" height="18" as="geometry" />
        </mxCell>

        <!-- Swimlane: Frontend -->
        <mxCell id="sw-frontend" value="① 前端层  ·  Vue 3 + Vite + Electron  ·  src/App.vue / src/api.js" style="swimlane;startSize=30;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;html=1;" vertex="1" parent="1">
