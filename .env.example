# ============== JWT 认证配置 ==============
# JWT 密钥（必须设置，长度至少 32 字符）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please_change_this_to_a_random_string_at_least_32_chars_long

# Database Configuration
# PostgreSQL 连接字符串 (用于 SQLAlchemy AsyncIO)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aicontent

# PostgreSQL 连接字符串 (用于 psycopg3 / LangGraph Checkpointer)
POSTGRES_URI=postgresql://postgres:password@localhost:5432/aicontent

# Application Settings
APP_NAME=Blink
DEBUG=true

# LLM Configuration (火山引擎 Doubao)
# 在此填写你的API Key
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 标准模型 (文章写作用，需要高质量输出)
LLM_MODEL=doubao-seed-1-8-251228
LLM_TEMPERATURE=0.7

# 快速模型 (选题生成、配图要点提取用，追求速度)
LLM_MODEL_FAST=doubao-seed-1-6-flash-250828
LLM_TEMPERATURE_FAST=0.7
LLM_TEMPERATURE_EXTRACT=0.4

# LangSmith 配置 (追踪与监控)
# 启用 LangSmith 追踪
LANGCHAIN_TRACING_V2=true
# 你的 LangSmith API Key（请替换为你的实际 key）
LANGCHAIN_API_KEY=your_key_here
# 项目名称（在 LangSmith 中显示）
LANGCHAIN_PROJECT=blink
# LangSmith 端点（官方默认端点）
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ============== 日志配置 ==============
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志输出目标: file, loki, aliyun, volcengine
# 目前支持 file，后续可扩展云服务
LOG_TARGET=file

# 日志文件目录
LOG_DIR=logs

# 是否在控制台输出日志（开发时建议 true）
LOG_CONSOLE=true

# 控制台是否输出 JSON 格式（false 则彩色输出，开发友好）
LOG_JSON=false

# 是否启用 PII 脱敏（邮箱、信用卡、API Key、手机号）
LOG_PII_ANONYMIZE=true

# ============== Embedding 配置 (SiliconFlow) ==============
# Embedding API Key
EMBEDDING_API_KEY=***
# Embedding API 地址
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# Embedding 模型
EMBEDDING_MODEL=BAAI/bge-m3

# ============== 图片生成配置 (Gemini) ==============
# Gemini 图片生成 API Key
IMAGE_API_KEY=your_key_here
# API 基础地址（国内加速）
IMAGE_BASE_URL=https://cn-beijing.yuannengai.com
# 图片生成模型
IMAGE_MODEL=gemini-3-pro-image-preview

# ============== CORS 配置 ==============
# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8000